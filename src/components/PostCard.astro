---
import { formatDate, readingMinutes, type Post } from '../lib/posts';
interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<a class="card post-card reveal" href={`/blog/${post.id}`}>
  <span class="post-meta">{post.data.category}{post.data.status !== 'published' && ' · Not published'}</span>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <span class="post-meta">{formatDate(post.data.publishDate)} · {readingMinutes(post.body)} min read</span>
</a>
