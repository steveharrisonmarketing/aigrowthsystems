---
// The invitation to take the audit, used at the end of posts and on the blog page.
import { site } from '../config/site';
---

<div class="card card--gold audit-box">
  <div>
    <h2 class="h3">Find out where AI grows your business.</h2>
    <p class="mt-3">Answer a few quick questions and get your AI score and top 3 quick wins in minutes. Free.</p>
  </div>
  <a class="btn btn-primary" href={site.auditUrl}>Get my free AI Growth Audit</a>
</div>
