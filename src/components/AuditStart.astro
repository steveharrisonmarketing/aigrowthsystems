---
// The opt-in box: email only. The questions that follow are on the audit page.
import { site } from '../config/site';
interface Props {
  id: string;
  pulse?: boolean;
}
const { id, pulse = false } = Astro.props;
---

<form class="audit-email" data-audit-email action={site.auditUrl}>
  <div>
    <label class="sr-only" for={id}>Your email address</label>
    <input class="field" id={id} name="email" type="email" placeholder="you@yourbusiness.co.uk" autocomplete="email" required />
  </div>
  <button class:list={['btn', 'btn-primary', { 'btn-pulse': pulse }]} type="submit">Get my free AI Growth Audit</button>
</form>
<p class="small mt-4">{site.auditSmallPrint} We’ll email your audit to this address. <a href="/privacy">Privacy</a></p>

<script>
  // Carries the email, and the ad tags from the address, into the audit questions.
  document.querySelectorAll<HTMLFormElement>('[data-audit-email]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      try {
        const q = new URLSearchParams(location.search);
        sessionStorage.setItem(
          'auditStart',
          JSON.stringify({
            email: new FormData(form).get('email'),
            sourcePage: location.pathname,
            referrer: document.referrer,
            utm_source: q.get('utm_source') ?? '',
            utm_campaign: q.get('utm_campaign') ?? '',
            utm_content: q.get('utm_content') ?? '',
          }),
        );
      } catch {}
      location.href = form.getAttribute('action') || '/assessment';
    });
  });
</script>
