---
// "What you get". With the sample audit beside it (home page) or as three cards (landing page, where the sample is in the hero).
import Draft from './Draft.astro';
import SampleAudit from './SampleAudit.astro';
interface Props {
  sample?: boolean;
}
const { sample = true } = Astro.props;

const included = [
  { title: 'Your AI score', text: 'A score out of 100 showing how much room there is for AI to help in your business.' },
  { title: 'Your top 3 quick wins', text: 'The three jobs where AI could save you the most time, with the tool to use and how much effort each one takes to set up.' },
  { title: 'Where to start', text: 'A plain-English first step, so you know what to do next.' },
];
---

{sample ? (
  <div class="get-grid">
    <div class="reveal">
      <span class="eyebrow">What you get</span>
      <h2 class="mt-4">Your audit, on screen in minutes.</h2>
      <ul class="get-list">
        {included.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="reveal">
      <SampleAudit />
      <Draft>A made-up example to show the layout. It’s replaced with a real screenshot once the audit is built.</Draft>
    </div>
  </div>
) : (
  <>
    <div class="section-head reveal">
      <span class="eyebrow">What you get</span>
      <h2>Your audit, on screen in minutes.</h2>
    </div>
    <div class="grid grid-3">
      {included.map((item) => (
        <div class="card reveal">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </>
)}
