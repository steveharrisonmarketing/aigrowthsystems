---
// "What you get" as three cards.
interface Props {
  sample?: boolean;
}
// The made-up sample that sat beside this list on the home page was removed. The prop is kept so callers don't change.
void Astro.props;

const included = [
  { title: 'Your AI score', text: 'A score out of 100 showing how much room there is for AI to help in your business.' },
  { title: 'Your top 3 quick wins', text: 'The three jobs where AI could save you the most time, with the tool to use and how much effort each one takes to set up.' },
  { title: 'Where to start', text: 'A plain-English first step, so you know what to do next.' },
];
---

  <>
    <div class="section-head reveal">
      <span class="eyebrow">What you get</span>
      <h2>Your audit, on screen in minutes.</h2>
    </div>
    <div class="grid grid-3">
      {included.map((item) => (
        <div class="card reveal">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </>

