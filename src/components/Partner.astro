---
import { offer, gbp } from '../config/offer';
import OfferButtons from './OfferButtons.astro';
const p = offer.partner;
---

<div class="grid grid-2" style="align-items: center;" id="partner">
  <div class="reveal">
    <span class="eyebrow">Ongoing support</span>
    <h2 class="mt-4">{p.name}</h2>
    <p class="lead mt-5">{p.summary}</p>
    <p class="mt-4">For anyone who has finished {offer.setup.name} or {offer.quickStart.name}.</p>
  </div>
  <div class="card reveal">
    <p class="price gold-text">{gbp(p.pricePerMonth)}<span style="font-size: 0.35em; letter-spacing: 0;"> /month</span></p>
    <p class="price-sub">Cancel any time. {offer.vatNote}</p>
    <ul class="tick-list mt-6">
      {p.includes.map((item) => <li>{item}</li>)}
    </ul>
    <OfferButtons id="partner" buy={p.buy} checkoutUrl={p.checkoutUrl} callLabel="Ask about AI Partner on your free call" />
  </div>
</div>
