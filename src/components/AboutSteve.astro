---
import Draft from './Draft.astro';
interface Props {
  link?: boolean;
}
const { link = true } = Astro.props;
---

<div class="about">
  <div class="photo-slot reveal">A real photo of Steve goes here</div>
  <div class="reveal">
    <span class="eyebrow">About Steve</span>
    <h2 class="mt-4">Built by someone who does this every week.</h2>
    <p class="lead mt-5">
      I’m Steve Harrison. My background is marketing agency work: Google Ads, Facebook Ads, website conversion, and
      email and SMS follow-up. AI Growth Systems is where I set up AI inside small UK businesses.
    </p>
    <p class="mt-4">Everything you see on this site comes from my own business and client work.</p>
    {link && <p class="mt-6"><a class="text-link" href="/about">More about Steve</a></p>}
    <Draft>Heading and wording are a first draft, to be rewritten from your answers in the About interview.</Draft>
  </div>
</div>
