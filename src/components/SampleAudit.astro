---
// A clearly labelled sample of the audit. Replaced by a real screenshot once the audit is built.
// Each quick win names the part of the business's income it supports. No money figures: those would be invented.
const sampleWins = [
  { title: 'Replying to enquiries', fix: 'AI answers every enquiry within minutes, so fewer go cold.', grows: 'New customers', effort: 'Low' },
  { title: 'Following up quotes', fix: 'Every quote gets a follow-up, without you remembering to send it.', grows: 'Quotes turned into work', effort: 'Low' },
  { title: 'Chasing invoices', fix: 'Reminders go out on their own when a payment is late.', grows: 'Getting paid sooner', effort: 'Medium' },
];
---

<div class="card sample">
  <span class="sample-tag">Sample</span>
  <div class="sample-top">
    <div class="score-ring"><span class="gold-text">72</span></div>
    <div>
      <p class="sample-label">AI score</p>
      <p class="sample-meaning">Lots of room for AI to help you grow</p>
    </div>
  </div>
  <p class="sample-label mt-8">Top 3 quick wins</p>
  <ol class="sample-wins">
    {sampleWins.map((win, i) => (
      <li>
        <span class="step-n">{i + 1}</span>
        <div>
          <p class="sample-win">{win.title}</p>
          <p>{win.fix}</p>
          <p class="sample-grows">Helps with: <strong>{win.grows}</strong></p>
          <p class="small">Effort to set up: {win.effort}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
