---
import { site } from '../config/site';
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={minimal ? path : '/'} aria-label="AI Growth Systems – home">AI <span class="gold-text">Growth</span> Systems</a>

    <div class="header-right">
      {!minimal && (
        <nav class="nav-links" aria-label="Main">
          {site.nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      )}
      {(!minimal || path === site.landingUrl) && (
        <a class="btn btn-primary btn-sm" href={minimal ? '#start' : site.auditUrl}>
          <span class="label-long">{site.auditName}</span>
          <span class="label-short">Free AI audit</span>
        </a>
      )}
      {!minimal && (
        <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
            <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </button>
      )}
    </div>
  </div>

  {!minimal && (
    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  )}
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
