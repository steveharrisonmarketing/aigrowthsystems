---
interface Props {
  items: { q: string; a: string; draft?: string }[];
}
const { items } = Astro.props;
import Draft from './Draft.astro';

// Tells search engines and AI assistants these are questions and answers.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <div class="answer">
        <p>{item.a}</p>
        {item.draft && <Draft>{item.draft}</Draft>}
      </div>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
