---
// The audit questions. Reached from the email opt-in. No menu, so there is one thing to do.
import Base from '../layouts/Base.astro';
import Draft from '../components/Draft.astro';
import { site } from '../config/site';

const teamSizes = ['Just me', '2–5', '6–20', '20+'];
const aiUse = ['Not yet', 'A little', 'Regularly'];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const challenges = ['Getting more customers', 'Turning enquiries into sales', 'Too much admin', 'Not enough time', 'Something else'];
---

<Base title={`${site.auditName} | AI Growth Systems`} description="A few quick questions about your business. About 2 minutes." noindex landing>
  <section class="section">
    <div class="wrap narrow">
      <span class="eyebrow">{site.auditName}</span>
      <h1 class="h2 mt-4">Tell us about your business.</h1>
      <p class="lead mt-4">About 2 minutes. Your audit appears on screen straight after and is emailed to you.</p>

      <form class="q-form" data-audit-form novalidate>
        <div class="grid grid-2">
          <div>
            <label class="q" for="q-name">First name</label>
            <input class="field" id="q-name" name="firstName" type="text" autocomplete="given-name" required />
          </div>
          <div>
            <label class="q" for="q-email">Email</label>
            <input class="field" id="q-email" name="email" type="email" autocomplete="email" placeholder="you@yourbusiness.co.uk" required />
          </div>
        </div>

        <div>
          <label class="q" for="q-site">Website</label>
          <input class="field" id="q-site" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.co.uk" />
          <p class="hint">No website? Leave this blank.</p>
        </div>

        <fieldset>
          <legend>Team size</legend>
          <div class="choices">
            {teamSizes.map((v) => (
              <label class="choice"><input type="radio" name="teamSize" value={v} required /><span>{v}</span></label>
            ))}
          </div>
        </fieldset>

        <div>
          <label class="q" for="q-tasks">What tasks take the most time in your business?</label>
          <textarea class="field" id="q-tasks" name="tasks" placeholder="e.g. replying to emails, social media posts, chasing invoices, booking appointments" required></textarea>
        </div>

        <fieldset>
          <legend>Have you used any AI tools before?</legend>
          <div class="choices">
            {aiUse.map((v) => (
              <label class="choice"><input type="radio" name="aiUse" value={v} required /><span>{v}</span></label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>What’s your biggest business challenge right now?</legend>
          <div class="choices">
            {challenges.map((v) => (
              <label class="choice"><input type="radio" name="challenge" value={v} required /><span>{v}</span></label>
            ))}
          </div>
        </fieldset>

        <div>
          <label class="q" for="q-more">Anything else you’d like us to know? <span style="color: var(--subtle); font-weight: 400;">(optional)</span></label>
          <textarea class="field" id="q-more" name="more"></textarea>
        </div>

        <div class="sr-only" aria-hidden="true">
          <label for="q-fax">Leave this box empty</label>
          <input id="q-fax" name="company_fax" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="check">
          <input type="checkbox" name="marketing" />
          <span>Also send me occasional emails about using AI in a business. You can unsubscribe at any time.</span>
        </label>

        <div>
          <p class="hint" data-form-error role="alert" style="color: var(--error); display: none; margin: 0 0 12px;"></p>
          {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark" data-size="flexible" style="margin-bottom: 16px;"></div>}
          <button class="btn btn-primary" type="submit">Get my free AI Growth Audit</button>
          <p class="small mt-4">We use your answers to write your audit and email it to you. <a href="/privacy">Privacy</a></p>
        </div>
      </form>
    </div>
  </section>
</Base>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-audit-form]');
  const email = document.getElementById('q-email') as HTMLInputElement | null;
  const error = form?.querySelector<HTMLElement>('[data-form-error]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  // The email typed on the previous page, and the ad tags from the landing address, are carried over.
  let start: Record<string, string> = {};
  try {
    start = JSON.parse(sessionStorage.getItem('auditStart') || '{}');
  } catch {}
  if (email && start.email) email.value = start.email;

  const showError = (message: string) => {
    if (!error) return;
    error.textContent = message;
    error.style.display = message ? 'block' : 'none';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      showError('Please answer every question that isn’t marked optional.');
      form.querySelector<HTMLElement>(':invalid:not(fieldset)')?.focus();
      return;
    }
    showError('');
    const data = new FormData(form);
    const body = {
      ...Object.fromEntries([...data.entries()].filter(([, v]) => typeof v === 'string')),
      marketing: data.get('marketing') === 'on',
      turnstileToken: data.get('cf-turnstile-response') ?? '',
      sourcePage: start.sourcePage ?? location.pathname,
      referrer: start.referrer ?? document.referrer,
      utm_source: start.utm_source ?? '',
      utm_campaign: start.utm_campaign ?? '',
      utm_content: start.utm_content ?? '',
    };
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    try {
      const response = await fetch('/api/audit', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const result = await response.json();
      if (result.ok) {
        location.href = `/assessment/result?id=${result.id}`;
        return;
      }
      showError(result.message || 'Something went wrong. Please try again.');
    } catch {
      showError('We couldn’t reach the server. Check your connection and try again.');
    }
    if (button) {
      button.disabled = false;
      button.textContent = 'Get my free AI Growth Audit';
    }
  });
</script>
