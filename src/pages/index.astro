---
// Home page. Main action: start the Free AI Growth Audit. Second: see the paid options.
import Base from '../layouts/Base.astro';
import Draft from '../components/Draft.astro';
import AuditStart from '../components/AuditStart.astro';
import AuditPreview from '../components/AuditPreview.astro';
import AboutSteve from '../components/AboutSteve.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config/site';
import { offer, gbp } from '../config/offer';

const s = offer.setup;

const steps = [
  { title: site.auditName, text: 'Answer a few quick questions. Your AI score and top 3 quick wins appear on screen in minutes.' },
  { title: 'Free 30-minute call', text: 'We go through your audit and what we’d set up first. No obligation.' },
  { title: `${s.name} or ${offer.quickStart.name}`, text: 'We build your AI set-up for you, then coach you one-to-one to use it.' },
  { title: offer.partner.name, text: 'Optional monthly support that keeps it working and adds to it. Cancel any time.' },
];

const cards = [
  offer.session.enabled && { name: offer.session.name, price: gbp(offer.session.price), text: offer.session.summary, href: `${site.setupUrl}#session` },
  offer.quickStart.enabled && { name: offer.quickStart.name, price: gbp(offer.quickStart.price), text: offer.quickStart.summary, href: `${site.setupUrl}#quick-start` },
  s.enabled && { name: s.name, price: gbp(s.price), text: s.summary, href: site.setupUrl, gold: true },
  offer.partner.enabled && { name: offer.partner.name, price: `${gbp(offer.partner.pricePerMonth)} /month`, text: offer.partner.summary, href: `${site.setupUrl}#partner` },
].filter(Boolean) as { name: string; price: string; text: string; href: string; gold?: boolean }[];

const faqs = [
  { q: 'Is the audit really free?', a: 'Yes. There’s no card and no payment at any point in the audit, and no obligation to buy anything afterwards.' },
  { q: 'How long does it take?', a: 'About 2 minutes to answer the questions. Your audit appears on screen a few minutes later and is emailed to you as well.' },
  { q: 'Do I need to be technical?', a: 'No. The questions are about your business, not about AI, and the audit is written in plain English.' },
  { q: 'What happens after the audit?', a: 'That’s up to you. You can act on it yourself, book a free 30-minute call to talk it through, or have us set things up for you.' },
  { q: 'What does it cost to work with you?', a: `Paid options start at ${gbp(offer.session.price)}. Every price is on the ${s.name} page.` },
  {
    q: 'What happens to my information?',
    a: 'We use your answers to write your audit and to email it to you. We don’t sell your details.',
    draft: 'Confirm this is true before go-live, and that the privacy page says the same.',
  },
];

const builds = ['Post 1', 'Post 2', 'Post 3'];
---

<Base
  title="AI Growth Systems | Find out where AI fits in your business"
  description="Take the Free AI Growth Audit: your AI score and top 3 quick wins on screen in minutes. Then get AI set up in your business, one-to-one. For UK businesses."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-frame">
        <div class="hero-visual" aria-hidden="true"></div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <span class="eyebrow">{site.auditName}</span>
          <h1 data-headline>{site.headlines[site.defaultHeadline]}</h1>
          <p class="lead">{site.heroSub}</p>
          <AuditStart id="hero-email" pulse />
        </div>
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section section--raised">
    <div class="wrap">
      <AuditPreview />
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>It starts with a free audit.</h2>
        <p class="lead">Everything after it is one-to-one, and you can start any week.</p>
      </div>
      <div class="grid grid-4">
        {steps.map((step, i) => (
          <div class="card reveal">
            <span class="step-n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
      <div class="btn-row mt-10 reveal">
        <a class="btn btn-primary" href={site.auditUrl}>Get my free AI Growth Audit</a>
      </div>
    </div>
  </section>

  <!-- Paid options -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Work with us</span>
        <h2>When you want it done properly.</h2>
        <p class="lead">One-to-one. Start any week.</p>
      </div>
      <div class="grid grid-4">
        {cards.map((card) => (
          <a class:list={['card', 'offer-link', 'reveal', { 'card--gold': card.gold }]} href={card.href}>
            <h3>{card.name}</h3>
            <p class="offer-price">{card.price}</p>
            <p>{card.text}</p>
            <span class="text-link">See what’s included</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="wrap">
      <AboutSteve />
    </div>
  </section>

  <!-- Latest posts -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">From the blog</span>
        <h2>See what we’re building.</h2>
      </div>
      <div class="grid grid-3">
        {builds.map((b) => (
          <div class="reveal">
            <div class="video-thumb"><span class="play" aria-hidden="true"></span></div>
            <p class="video-title">{b}</p>
          </div>
        ))}
      </div>
      <Draft>Stand-in cards. The 3 latest posts appear here once the blog has posts.</Draft>
      <p class="mt-8 reveal"><a class="text-link" href="/blog">All posts</a></p>
    </div>
  </section>

  <!-- Testimonials and "what we're seeing in audits" stay hidden until real ones exist. -->

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="eyebrow">Questions</span>
        <h2>Before you start.</h2>
      </div>
      <div class="reveal"><Faq items={faqs} /></div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="section cta-band">
    <div class="wrap reveal">
      <h2>Find your first AI quick win.</h2>
      <div class="cta-form"><AuditStart id="cta-email" /></div>
    </div>
  </section>
</Base>

<script>
  // Headline preview: ?h=a, ?h=b or ?h=c. The real one-per-visitor test is added with the server functions.
  import { site } from '../config/site';
  const h = new URLSearchParams(location.search).get('h')?.toLowerCase();
  const el = document.querySelector('[data-headline]');
  if (el && (h === 'a' || h === 'b' || h === 'c')) el.textContent = site.headlines[h];
</script>
