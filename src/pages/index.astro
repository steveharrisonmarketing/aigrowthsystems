---
import Base from '../layouts/Base.astro';
import Draft from '../components/Draft.astro';
import Compare from '../components/Compare.astro';
import Guarantee from '../components/Guarantee.astro';
import Partner from '../components/Partner.astro';
import Calculator from '../components/Calculator.astro';
import AboutSteve from '../components/AboutSteve.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config/site';
import { offer, gbp, instalmentTotal, weeks, groupCallMinutes } from '../config/offer';

const s = offer.setup;

const steps = [
  { title: site.auditName, text: 'Answer a few questions. Your AI score and top 3 quick wins appear on screen in minutes.' },
  { title: 'Free 30-minute call', text: 'Steve walks you through your audit and your AI setup plan. No obligation.' },
  { title: s.name, text: `AI set up in your business in ${s.weeks} weeks: built for you, then taught to you and your team.` },
  { title: offer.partner.name, text: 'Optional monthly support that keeps it working and adds to it. Cancel any time.' },
];

const priceAnswer =
  `${gbp(s.price)}, or ${s.instalments.count} payments of ${gbp(s.instalments.amount)} (${gbp(instalmentTotal)} in total). ` +
  (s.founding.enabled
    ? `The founding group price is ${gbp(s.founding.price)}: that’s the first ${s.groupCap} businesses, in return for sharing results. `
    : '') +
  `${offer.partner.name} afterwards is optional, at ${gbp(offer.partner.pricePerMonth)} a month.`;

const faqs = [
  { q: 'Is it really free?', a: 'Yes. The audit is free, and there’s no obligation to book a call or buy anything afterwards.' },
  {
    q: 'What do I get instantly, and what comes later?',
    a: 'On screen in minutes: your AI score, your top 3 quick wins and your AI setup plan. Later: a fuller audit that Steve reviews himself and emails to you.',
  },
  {
    q: 'How long until I get the full audit?',
    a: 'Steve reviews every audit personally before it’s sent, so it follows by email after your instant result.',
    draft: 'The number of working days goes here once you confirm it.',
  },
  {
    q: 'What happens on the free call?',
    a: 'It’s 30 minutes on video with Steve. He walks you through your audit and your AI setup plan: the first automation he’d build and the three assistants. You’ll hear the price and the next start date. There’s no obligation.',
  },
  { q: `What does ${s.name} cost?`, a: priceAnswer, draft: 'VAT wording to add once confirmed.' },
  {
    q: 'What if I’m not technical?',
    a: 'You don’t need to be. The set-up is done for you, and the weekly calls show you and your team how to use it in plain English.',
  },
  {
    q: 'Is my business data safe?',
    a: 'Your AI workspace is set up with its data-safety settings switched on, and you get a one-page staff AI policy that says what can and can’t go into AI tools.',
    draft: 'Every data-safety claim needs your confirmation before go-live.',
  },
];

const builds = ['Build video 1', 'Build video 2', 'Build video 3'];
---

<Base
  title="AI Growth Systems | AI set up in your business in 6 weeks"
  description="Take the Free AI Growth Audit: your AI score and top 3 quick wins on screen in minutes, then a full audit reviewed by Steve. For small UK businesses."
>
  <!-- 2. Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-frame">
        <div class="hero-visual" aria-hidden="true"></div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <span class="eyebrow">{site.auditName}</span>
          <h1 data-headline>{site.headlines[site.defaultHeadline]}</h1>
          <p class="lead" data-variant="heroSub">{site.heroSub}</p>

          <form class="audit-start" data-audit-start action={site.auditUrl}>
            <div>
              <label class="sr-only" for="hero-site">Your website address</label>
              <input class="field" id="hero-site" name="website" type="text" inputmode="url" placeholder="yourbusiness.co.uk" autocomplete="url" required />
            </div>
            <div>
              <label class="sr-only" for="hero-email">Your email address</label>
              <input class="field" id="hero-email" name="email" type="email" placeholder="you@yourbusiness.co.uk" autocomplete="email" required />
            </div>
            <button class="btn btn-primary btn-pulse" type="submit">Get my free AI Growth Audit</button>
          </form>
          <p class="small mt-4">Free. UK businesses.</p>
          <Draft>The gold light behind this text is a stand-in for the Higgsfield hero video (asset H1). Nothing is generated until you approve the brief and the credits.</Draft>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. How it works -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>4 steps. It starts with a free audit.</h2>
        <Draft>This heading is a draft for you to approve.</Draft>
      </div>
      <div class="grid grid-4">
        {steps.map((step, i) => (
          <div class="card reveal">
            <span class="step-n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
      <div class="btn-row mt-10 reveal">
        <a class="btn btn-primary" href={site.auditUrl}>Get my free AI Growth Audit</a>
      </div>
    </div>
  </section>

  <!-- 4. Comparison -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Why this is different</span>
        <h2>Set up for you, not dumped on you.</h2>
        <p class="lead">Most owners don’t need another course or another login. They need AI working inside the business they already run.</p>
      </div>
      <div class="reveal"><Compare /></div>
      <p class="mt-8 reveal"><a class="text-link" href={site.setupUrl}>How {s.name} works</a></p>
    </div>
  </section>

  <!-- 5. 6-week overview -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">The {s.weeks} weeks</span>
        <h2>What happens in {s.weeks} weeks.</h2>
        <p class="lead">Steve builds your set-up for you. Then a {groupCallMinutes}-minute group call each week puts it to work, one part of the business at a time.</p>
      </div>
      <div class="weeks-grid">
        {weeks.map((w) => (
          <div class="card week-card reveal">
            <span class="wk">Week {w.n}</span>
            <p>{w.topic}</p>
          </div>
        ))}
      </div>
      <div class="btn-row mt-10 reveal">
        <a class="btn btn-secondary" href={site.setupUrl}>See the full plan</a>
      </div>
    </div>
  </section>

  <!-- 6. Guarantee -->
  <section class="section">
    <div class="wrap">
      <Guarantee />
    </div>
  </section>

  <!-- 7. AI Partner -->
  <section class="section section--raised">
    <div class="wrap">
      <Partner />
    </div>
  </section>

  <!-- 8. Calculator -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">What it’s costing you</span>
        <h2>What are slow replies putting at risk?</h2>
        <p class="lead">Move the sliders to match your own business.</p>
        <Draft>This heading is a draft for you to approve.</Draft>
      </div>
      <Calculator />
    </div>
  </section>

  <!-- 9. Data safety -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Data safety</span>
        <h2>Your client data stays yours.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card reveal">
          <h3>Safety settings switched on</h3>
          <p>Your business AI workspace is set up for you, with its data-safety settings turned on from day one.</p>
        </div>
        <div class="card reveal">
          <h3>A staff AI policy</h3>
          <p>One page that tells your team what can and can’t go into AI tools.</p>
        </div>
        <div class="card reveal">
          <h3>UK GDPR in plain English</h3>
          <p>How your data is handled is explained before any work starts.</p>
        </div>
      </div>
      <Draft>These three points are placeholders. Tell me which tools and practices you really use with client data and I’ll rewrite them. Links to the data-safety blog posts are added in Phase 4.</Draft>
    </div>
  </section>

  <!-- 10. Latest builds -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Real builds</span>
        <h2>Watch what I’m building.</h2>
      </div>
      <div class="grid grid-3">
        {builds.map((b) => (
          <div class="reveal">
            <div class="video-thumb"><span class="play" aria-hidden="true"></span></div>
            <p class="video-title">{b}</p>
          </div>
        ))}
      </div>
      <Draft>Stand-in cards. Your 3 latest video posts appear here once the blog is built (Phase 4). Nothing loads from YouTube until a visitor clicks.</Draft>
      <p class="mt-8 reveal"><a class="text-link" href="/blog">All posts</a></p>
    </div>
  </section>

  <!-- 11. About Steve -->
  <section class="section section--raised">
    <div class="wrap">
      <AboutSteve />
    </div>
  </section>

  <!-- 12 + 13. "What I'm seeing in audits" and testimonials stay hidden until real ones exist. -->

  <!-- 14. FAQ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="eyebrow">Questions</span>
        <h2>Before you start.</h2>
      </div>
      <div class="reveal"><Faq items={faqs} /></div>
    </div>
  </section>

  <!-- 15. Final call to action -->
  <section class="section cta-band">
    <div class="wrap reveal">
      <h2>Find your first AI quick win.</h2>
      <a class="btn btn-primary" href={site.auditUrl}>Get my free AI Growth Audit</a>
      <p class="small mt-4">Free. UK businesses.</p>
    </div>
  </section>
</Base>

<script>
  // Headline preview: ?h=a, ?h=b or ?h=c. The real one-per-visitor test is added with the server functions.
  import { site } from '../config/site';
  const h = new URLSearchParams(location.search).get('h')?.toLowerCase();
  const el = document.querySelector('[data-headline]');
  if (el && (h === 'a' || h === 'b' || h === 'c')) el.textContent = site.headlines[h];

  // The hero form carries the two answers into the audit without putting them in the address bar.
  const form = document.querySelector<HTMLFormElement>('[data-audit-start]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    try {
      sessionStorage.setItem('auditStart', JSON.stringify({ website: data.get('website'), email: data.get('email') }));
    } catch {}
    location.href = form.getAttribute('action') || '/assessment';
  });
</script>
