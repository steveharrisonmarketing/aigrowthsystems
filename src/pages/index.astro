---
// Home page. Main action: start the Free AI Growth Audit. Second: see the paid options.
import Base from '../layouts/Base.astro';
import AuditStart from '../components/AuditStart.astro';
import AuditPreview from '../components/AuditPreview.astro';
import AboutSteve from '../components/AboutSteve.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config/site';
import { offer, gbp, planCredit } from '../config/offer';
import PostCard from '../components/PostCard.astro';
import { visiblePosts } from '../lib/posts';

const s = offer.setup;

const steps = [
  { title: site.auditName, text: 'Answer a few quick questions. Your AI score and top 3 quick wins appear on screen in minutes.' },
  { title: offer.session.name, text: 'We go through what your audit found and turn it into a step-by-step plan.' },
  { title: s.name, text: 'We build your AI set-up for you, then coach you one-to-one to use it.' },
];

const faqs = [
  {
    q: `What is the ${site.auditName}?`,
    a: 'A short online questionnaire about your business. From your answers we give you an AI score out of 100, the top 3 jobs where AI could save you the most time, and a first step to take. It’s free and takes about 2 minutes.',
  },
  { q: 'Is the audit really free?', a: 'Yes. There’s no card and no payment at any point in the audit, and no obligation to buy anything afterwards.' },
  { q: 'How long does it take?', a: 'About 2 minutes to answer the questions. Your audit appears on screen a few minutes later and is emailed to you as well.' },
  { q: 'Do I need to be technical?', a: 'No. The questions are about your business, not about AI, and the audit is written in plain English.' },
  { q: 'What happens after the audit?', a: `That’s up to you. You can act on it yourself, book an ${offer.session.name} to turn it into a plan, or have us set everything up for you.` },
  { q: 'What does it cost to work with you?', a: `The ${offer.session.name} is ${gbp(offer.session.price)}. ${s.name} is ${gbp(s.price)}. If you take the call first and upgrade within ${offer.session.creditDays} days, the ${gbp(offer.session.price)} comes off.` },
  {
    q: 'What happens to my information?',
    a: 'We use your answers to write your audit and to email it to you. We don’t sell your details.',
    draft: 'Confirm this is true before go-live, and that the privacy page says the same.',
  },
];

const latest = (await visiblePosts()).slice(0, 3);
---

<Base
  title="AI Growth Systems | Find out where AI grows your business"
  description="Take the Free AI Growth Audit: your AI score and top 3 quick wins on screen in minutes. Then turn it into a plan, or have us set it up for you. For UK businesses."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-frame">
        <div class="hero-visual" aria-hidden="true"></div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <span class="eyebrow">{site.auditName}</span>
          <h1 data-headline>{site.headlines[site.defaultHeadline]}</h1>
          <p class="lead">{site.heroSub}</p>
          <AuditStart id="hero-email" pulse />
        </div>
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section section--raised">
    <div class="wrap">
      <AuditPreview />
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>Audit. Plan. Setup.</h2>
        <p class="lead">Start with the free audit. Go as far as you want after that.</p>
      </div>
      <div class="grid grid-3">
        {steps.map((step, i) => (
          <div class="card reveal">
            <span class="step-n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Paid options: the call first, with the full set-up beside it -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Work with us</span>
        <h2>Want help putting it in place?</h2>
        <p class="lead">Two ways to do it. Both are one-to-one, and you can start any week.</p>
      </div>
      <div class="grid grid-2">
        <a class="card offer-link reveal" href={`${site.setupUrl}#plan-call`}>
          <span class="post-meta">We show you how</span>
          <h3>{offer.session.name}</h3>
          <p class="offer-price">{gbp(offer.session.price)}</p>
          <p>{offer.session.summary}</p>
          <p class="small">{planCredit}</p>
          <span class="text-link">See what’s included</span>
        </a>
        <a class="card card--gold offer-link reveal" href={site.setupUrl}>
          <span class="post-meta">We do it for you</span>
          <h3>{s.name}</h3>
          <p class="offer-price">{gbp(s.price)}</p>
          <p>{s.summary}</p>
          <span class="text-link">See what’s included</span>
        </a>
      </div>
      <p class="mt-8 reveal">Not sure which? <a class="text-link" href={site.auditUrl}>Start with the free audit</a></p>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="wrap">
      <AboutSteve />
    </div>
  </section>

  <!-- Latest posts: hidden until there is at least one -->
  {latest.length > 0 && (
    <section class="section section--raised">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="eyebrow">From the blog</span>
          <h2>See what we’re building.</h2>
        </div>
        <div class="grid grid-3">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
        <p class="mt-8 reveal"><a class="text-link" href="/blog">All posts</a></p>
      </div>
    </section>
  )}

  <!-- Testimonials and "what we're seeing in audits" stay hidden until real ones exist. -->

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="eyebrow">Questions</span>
        <h2>Before you start.</h2>
      </div>
      <div class="reveal"><Faq items={faqs} /></div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="section cta-band">
    <div class="wrap reveal">
      <h2>Find your first AI quick win.</h2>
      <div class="cta-form"><AuditStart id="cta-email" /></div>
    </div>
  </section>
</Base>

<script>
  // Headline preview: ?h=a, ?h=b or ?h=c. The real one-per-visitor test is added with the server functions.
  import { site } from '../config/site';
  const h = new URLSearchParams(location.search).get('h')?.toLowerCase();
  const el = document.querySelector('[data-headline]');
  if (el && (h === 'a' || h === 'b' || h === 'c')) el.textContent = site.headlines[h];
</script>
