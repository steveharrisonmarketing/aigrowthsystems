---
// The page a visitor sees after the questions: their audit, then one next step.
// With ?id=… in the address it loads that visitor's audit. With no id it shows sample content,
// in review mode only, so the layout can be checked.
import Base from '../../layouts/Base.astro';
import Draft from '../../components/Draft.astro';
import OfferButtons from '../../components/OfferButtons.astro';
import { site } from '../../config/site';
import { offer, gbp, planCredit } from '../../config/offer';
import { sampleResult } from '../../lib/auditSample';

const a = offer.session;

const sample = sampleResult;
---

<Base title={`Your ${site.auditName.replace('Free ', '')} | AI Growth Systems`} description="Your AI score and top 3 quick wins." noindex landing>
  <section class="section" data-loading hidden>
    <div class="wrap narrow" style="text-align: center;">
      <span class="eyebrow">Your audit</span>
      <h1 class="h2 mt-4">Writing your audit…</h1>
      <p class="lead mt-4" style="margin-inline: auto;">This usually takes under a minute. Please keep this page open.</p>
      <ul class="load-steps" aria-live="polite">
        <li data-step>Reading your answers</li>
        <li data-step>Looking at your business</li>
        <li data-step>Finding your quick wins</li>
      </ul>
    </div>
  </section>

  <section class="section" data-problem hidden>
    <div class="wrap narrow" style="text-align: center;">
      <h1 class="h2">We couldn’t finish your audit.</h1>
      <p class="lead mt-4" style="margin-inline: auto;" data-problem-text>Something went wrong on our side. Your answers are saved.</p>
      <div class="btn-row mt-8" style="justify-content: center;">
        <button class="btn btn-primary" type="button" data-retry>Try again</button>
      </div>
      <p class="small mt-4">Still stuck? Email <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>

  <div data-result data-review={site.showDraftNotes ? 'yes' : 'no'}>
  <section class="section">
    <div class="wrap narrow">
      <div data-sample-note><Draft block>This is a sample result so you can review the layout. A real one appears when a visitor finishes the questions.</Draft></div>

      <span class="eyebrow mt-8">Your audit</span>
      <div class="result-top mt-5">
        <div class="score-ring score-ring--lg" data-ring style={`--score: ${sample.score}%`}><span class="gold-text" data-score>{sample.score}</span></div>
        <div>
          <h1 class="h2"><span data-name></span>Your AI score: <span data-score>{sample.score}</span> out of 100</h1>
          <p class="lead mt-3" data-meaning>{sample.scoreMeaning}.</p>
        </div>
      </div>

      <h2 class="h3 mt-10">Your top 3 quick wins</h2>
      <ol class="result-wins" data-wins>
        {sample.wins.map((win, i) => (
          <li class="card">
            <span class="step-n">{i + 1}</span>
            <h3 data-w="title">{win.title}</h3>
            <p><strong>Now:</strong> <span data-w="problem">{win.problem}</span></p>
            <p><strong>With AI:</strong> <span data-w="fix">{win.fix}</span></p>
            <p><strong>What you’d use:</strong> <span data-w="tool">{win.tool}</span></p>
            <p class="sample-grows">Helps with: <strong data-w="helpsWith">{win.helpsWith}</strong> · Effort to set up: <span data-w="effort">{win.effort}</span></p>
            <p class="small">Estimated time saved: about <span data-w="hoursSavedPerWeek">{win.hoursSavedPerWeek}</span> hours a week. <span data-w="reasoning">{win.reasoning}</span></p>
          </li>
        ))}
      </ol>

      <h2 class="h3 mt-10">Where to start</h2>
      <p class="lead mt-3" data-first-step>{sample.firstStep}</p>

      <div data-unverified-wrap hidden>
        <h2 class="h3 mt-10">What we couldn’t check</h2>
        <ul class="prose mt-3" data-unverified></ul>
      </div>

      <p class="small mt-8">Time savings are estimates from your answers, not promises. <span data-emailed hidden>We’ve emailed you a copy of this audit.</span></p>
    </div>
  </section>

  {a.enabled && (
    <section class="section section--raised">
      <div class="wrap narrow">
        <span class="eyebrow">Your next step</span>
        <h2 class="mt-4">Turn this audit into a plan.</h2>
        <p class="lead mt-4">{a.summary}</p>
        <div class="card card--gold offer-card mt-8">
          <h3>{a.name}</h3>
          <p class="price mt-4">{gbp(a.price)}</p>
          <ul class="tick-list mt-6">
            {a.includes.map((item) => <li>{item}</li>)}
          </ul>
          <p class="mt-6" style="color: var(--text);"><strong>Your {gbp(a.price)} back:</strong> {planCredit}</p>
          <OfferButtons id="session" buy={a.buy} checkoutUrl={a.checkoutUrl} price={a.price} callLabel="Book your free call first" />
        </div>
        <p class="mt-8">Want it done for you instead? <a class="text-link" href={site.setupUrl}>See {offer.setup.name}</a></p>
      </div>
    </section>
  )}
  </div>
</Base>

<script>
  import { runResultPage } from '../../scripts/result';
  runResultPage();
</script>
