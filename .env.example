# Copy this file to ".env" and paste the real keys there.
# ".env" is never saved to git. Never paste a key into chat.
# Leave a key empty and that part is skipped: no AI key means a sample audit is shown,
# no Resend key means emails are not sent.

# Anthropic (writes the audit). Set a monthly spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=
# Only if Anthropic says the key "is not scoped to a workspace": the workspace's ID (starts wrkspc_). Not a secret.
ANTHROPIC_WORKSPACE_ID=

# Resend (sends the audit email and the "new audit" note to you).
RESEND_API_KEY=

# Cloudflare Turnstile (spam check on the audit form).
# The two values below are Cloudflare's published test keys: they always pass and only work for local testing.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Kit (email list). Not connected yet.
KIT_API_KEY=
