// Cloudflare settings: where the built site is, the database, and non-secret settings.
// Secrets (API keys) are never written here. They go in .env on your own computer
// and in Cloudflare's secrets for the live site.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aigrowthsystems",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // The database that stores each audit (created in Cloudflare on 10 October 2026).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aigrowthsystems",
      "database_id": "2ca1da8f-c512-4788-8f65-0a9e2bfd3326",
      "migrations_dir": "migrations"
    }
  ],
  // Astro's session store. Pinned to the namespace "wrangler deploy" created, because branch preview builds
  // ("wrangler versions upload") cannot create it and failed without an id.
  "kv_namespaces": [{ "binding": "SESSION", "id": "699f8df454074cca909192bee51dcd81" }],
  "vars": {
    // Where "new audit" notifications are sent.
    "AUDIT_NOTIFY_EMAIL": "info@aigrowthsystems.co.uk",
    // Resend's shared test sender. Change to info@aigrowthsystems.co.uk once the domain is verified with Resend.
    "EMAIL_FROM": "AI Growth Systems <onboarding@resend.dev>"
  }
}
